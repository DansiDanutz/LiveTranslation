# Copy this file to .env and fill in your values.

# --- OpenAI (required) -----------------------------------------------------
# Your OpenAI API key — used server-side only, never exposed to the browser.
# Needs access to the gpt-realtime-translate model.
OPENAI_API_KEY=sk-...

# --- Server ----------------------------------------------------------------
# Port for the local server (default 3000)
PORT=3000

# --- Supabase (Google sign-in + transcript history) ------------------------
# From your Supabase project: Settings → API.
# If these are left blank, the app runs in open/demo mode (no sign-in).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: enables saving session transcripts to the `sessions` table.
# Keep this SECRET — server-side only. From Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
