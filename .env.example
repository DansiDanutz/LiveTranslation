# Copy this file to .env and fill in your values.

# --- OpenAI (required) -----------------------------------------------------
# Your OpenAI API key — used server-side only, never exposed to the browser.
# Needs access to the gpt-realtime-translate model.
OPENAI_API_KEY=sk-...

# --- Server ----------------------------------------------------------------
# Port for the local server (default 3000)
PORT=3000

# --- Supabase (Google sign-in) ---------------------------------------------
# From your Supabase project: Settings → API.
# If these are left blank, the app runs in open/demo mode (no sign-in).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Access & spend controls (protect your OpenAI key) ---------------------
# Who is allowed to SPEND (translate / summarize / ask). Comma-separated emails.
#   unset  -> owner only (the built-in default)
#   "*"    -> any signed-in Google user
#   list   -> only these emails
ALLOWED_EMAILS=you@example.com

# Soft per-user daily cap on translation minutes (0 = unlimited).
MAX_MINUTES_PER_USER_PER_DAY=60

# Global daily budget stop in USD (0 = off). Needs SUPABASE_SERVICE_ROLE_KEY
# to measure usage across all users.
DAILY_BUDGET_USD=0
SUPABASE_SERVICE_ROLE_KEY=

# Model used for summaries / action items / Q&A (default gpt-4o-mini).
SUMMARY_MODEL=gpt-4o-mini
